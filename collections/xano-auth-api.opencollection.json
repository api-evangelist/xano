{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xano Metadata API Groups Auth API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Auth",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Retrieve the authenticated user.",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://{instance}.xano.io/api:meta/auth/me"
          },
          "docs": "Retrieve the authenticated user."
        }
      ]
    }
  ],
  "bundled": true
}