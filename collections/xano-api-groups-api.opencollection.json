{
  "opencollection": "1.0.0",
  "info": {
    "name": "Xano Metadata API Groups API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "API Groups",
        "type": "folder"
      },
      "items": [
        {
          "info": {
